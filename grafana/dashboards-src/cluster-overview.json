{
  "title": "Cluster Overview",
  "uid": "cluster-overview",
  "schemaVersion": 27,
  "panels": [
    {
      "type": "stat",
      "title": "Pods Running",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Pods con Errores",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count(kube_pod_status_phase{phase=~\"Failed|Unknown\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "CrashLoopBackOff activos",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count(kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"})", "refId": "A"}]
    },
    {
      "type": "graph",
      "title": "Reinicios por pod (5m)",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "targets": [{"expr": "rate(kube_pod_container_status_restarts_total[5m]) > 0", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}]
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s"
}

